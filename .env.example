# Copy to .env.local and fill in.
# Postgres connection string. On Neon: Dashboard > Connect > copy the *pooled* connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-too
# Public site URL for sitemap / canonical links
SITE_URL=http://localhost:3000
CONTACT_EMAIL=contact@example.com
# Reserved for later (server-side only, see lib/hooks.ts):
# DISCORD_WEBHOOK_URL=
